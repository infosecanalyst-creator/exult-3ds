+	// destroyed AFTER the stream. (As a member of the derived class it was
+	// freed first, and the stream's final flush on destruction then wrote
+	// from freed memory - corrupting the first bytes of any file that was not
+	// closed explicitly.)
+	struct StreamBufHolder {
+		std::unique_ptr<char[]> buf{new char[N3DS_STREAM_BUF]};
+	};
+
