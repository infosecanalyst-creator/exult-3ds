+void Image_window::n3ds_mark_layers(unsigned char* mask, int mw, int mh, unsigned char value) {
+	for (auto& lp : layers) {
+		if (!lp || !lp->visible || !lp->buf || lp->alpha < 128) {
+			continue;
+		}
+		const UiLayerKind kind = lp->ui_kind;
+		if (kind < UiLayerDefault || kind >= NumUiLayerKinds
+			|| (ui_layer_kind_mask & (1u << static_cast<int>(kind))) == 0) {
+			continue;
+		}
+		Layer&        layer = *lp;
+		Image_buffer* b     = layer.buf.get();
+		if (layer.logw <= 0 || layer.logh <= 0) {
+			continue;
+		}
+		SDL_FRect dst;
+		for (int i = 0; get_layer_dest(layer, dst, i); i++) {
+			if (dst.w <= 0 || dst.h <= 0) {
+				continue;
+			}
+			const int x0 = std::max(0, static_cast<int>(dst.x));
+			const int y0 = std::max(0, static_cast<int>(dst.y));
+			const int x1 = std::min(mw, static_cast<int>(dst.x + dst.w + 0.999f));
+			const int y1 = std::min(mh, static_cast<int>(dst.y + dst.h + 0.999f));
+			for (int y = y0; y < y1; y++) {
+				const int ly = static_cast<int>((y + 0.5f - dst.y) * layer.logh / dst.h);
+				if (ly < 0 || ly >= layer.logh) {
+					continue;
+				}
+				const unsigned char* row = b->bits + (ly + b->offset_y) * b->line_width + b->offset_x;
+				unsigned char*       out = mask + y * mw;
+				for (int x = x0; x < x1; x++) {
+					const int lx = static_cast<int>((x + 0.5f - dst.x) * layer.logw / dst.w);
+					if (lx >= 0 && lx < layer.logw && (layer.opaque || row[lx] != layer.transparent)) {
+						out[x] = value;
+					}
+				}
+			}
+		}
+	}
+}
