+		N3dsIfstream(const char* s, std::ios_base::openmode mode) {
+			rdbuf()->pubsetbuf(buf.get(), N3DS_STREAM_BUF);
+			open(s, mode);
+		}
+
+		~N3dsIfstream() override {
+			close();
+		}
+	};
+
+	struct N3dsOfstream : StreamBufHolder, std::ofstream {
+		N3dsOfstream(const char* s, std::ios_base::openmode mode) {
+			rdbuf()->pubsetbuf(buf.get(), N3DS_STREAM_BUF);
+			open(s, mode);
+		}
+
+		~N3dsOfstream() override {
+			close();    // flush while the buffer is still alive
+		}
+	};
+
+	struct CacheEntry {
+		FileData      data;
+		off_t         size;
+		time_t        mtime;
+		unsigned long last_use;
+	};
+
+	std::map<std::string, CacheEntry> file_cache;
+	unsigned long long                bytes_read_whole = 0;    // for the startup report
+	std::size_t                       cache_bytes = 0;
+	unsigned long                     cache_clock = 0;
+
+	void cache_drop(const std::string& path) {
+		auto it = file_cache.find(path);
+		if (it != file_cache.end()) {
+			cache_bytes -= it->second.data->size();
+			file_cache.erase(it);
+		}
+	}
+
+	void cache_make_room(std::size_t need) {
+		while (!file_cache.empty() && cache_bytes + need > N3DS_CACHE_TOTAL) {
+			auto oldest = file_cache.begin();
+			for (auto it = file_cache.begin(); it != file_cache.end(); ++it) {
+				if (it->second.last_use < oldest->second.last_use) {
+					oldest = it;
+				}
+			}
+			cache_bytes -= oldest->second.data->size();
+			file_cache.erase(oldest);
+		}
+	}
