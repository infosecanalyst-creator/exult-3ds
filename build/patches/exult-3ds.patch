+	std::unique_ptr<std::istream> n3ds_open_in(const char* s, std::ios_base::openmode mode) {
+		struct stat st {};
+		if (::stat(s, &st) != 0 || !S_ISREG(st.st_mode)) {
+			auto fail = std::make_unique<std::ifstream>();
+			fail->setstate(std::ios::failbit);
+			return fail;
+		}
+		if (st.st_size > N3DS_CACHE_FILE) {
+			return std::make_unique<N3dsIfstream>(s, mode);    // big file: read only what's needed
+		}
+		const std::string key(s);
+		auto              it = file_cache.find(key);
+		if (it != file_cache.end() && it->second.size == st.st_size && it->second.mtime == st.st_mtime) {
+			it->second.last_use = ++cache_clock;
+			return std::make_unique<MemIstream>(it->second.data);
+		}
+		cache_drop(key);
+		const int fd = ::open(s, O_RDONLY);
+		if (fd < 0) {
+			auto fail = std::make_unique<std::ifstream>();
+			fail->setstate(std::ios::failbit);
+			return fail;
+		}
+		auto        data = std::make_shared<std::vector<char>>(static_cast<std::size_t>(st.st_size));
+		std::size_t got  = 0;
+		while (got < data->size()) {
+			const std::size_t want = std::min(N3DS_READ_CHUNK, data->size() - got);
