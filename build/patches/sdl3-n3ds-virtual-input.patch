+/* Default: no right-eye image (both eyes see the left one). */
+__attribute__((weak)) int N3DS_StereoFrame(const void *src, int sw, int sh, int pitch, int bpp, void *rightfb, int fbw, int fbh, float slider)
+{
+    (void)src; (void)sw; (void)sh; (void)pitch; (void)bpp; (void)rightfb; (void)fbw; (void)fbh; (void)slider;
+    return 0;
+}
