+{
+    return -1;
+}
+
+/* Called after the game has been copied to the bottom screen (32-bit, rotated
+   framebuffer: fbw = 240 rows), so the app can draw a small overlay. */
+__attribute__((weak)) void N3DS_BottomOverlay(void *fb, int fbw, int fbh)
+{
+    (void)fb; (void)fbw; (void)fbh;
+}
+
+/* Which part of the window surface fills the bottom screen (default: the
+   middle 320x240). Exult-3DS uses a smaller rect to zoom in. */
+__attribute__((weak)) void N3DS_BottomView(int *sx, int *sy, int *sw, int *sh)
+{
+    (void)sx; (void)sy; (void)sw; (void)sh;
+}
+
+/* Scale a rect of the window surface to the bottom screen (nearest pixel). */
+static void CopyRectToBottom32(u32 *dest, int fbw, int fbh, const SDL_Surface *surface, int sx, int sy, int sw, int sh)
+{
+    static int xmap[400];
+    const int cols = SDL_min(fbh, 400);
+    for (int x = 0; x < cols; ++x) {
+        xmap[x] = sx + x * sw / cols;
+    }
+    for (int y = 0; y < fbw; ++y) {
+        const int syy = sy + y * sh / fbw;
+        const u32 *s = (const u32 *)((const u8 *)surface->pixels + (size_t)syy * surface->pitch);
+        u32 *d = dest + (fbw - y - 1);
+        for (int x = 0; x < cols; ++x, d += fbw) {
+            *d = s[xmap[x]];
+        }
+    }
+}
+
+/* Copy the centre of a wider window surface to the 320-pixel bottom screen. */
+static void CopyCentreToBottom32(u32 *dest, int fbw, int fbh, const SDL_Surface *surface)
+{
+    const int cols = SDL_min(fbh, surface->w);
+    const int rows = SDL_min(fbw, surface->h);
+    const int x0 = (surface->w - cols) / 2;
+    for (int y = 0; y < rows; ++y) {
+        const u32 *s = (const u32 *)((const u8 *)surface->pixels + (size_t)y * surface->pitch) + x0;
+        u32 *d = dest + (fbw - y - 1);
+        for (int x = 0; x < cols; ++x, d += fbw) {
+            *d = s[x];
+        }
+    }
+}
+
+/* Show the last frame again (e.g. after the app changed its overlay while the
+   game is paused and not drawing). */
