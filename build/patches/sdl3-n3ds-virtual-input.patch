@@ -254,10 +256,20 @@ static void N3DSAUDIO_ThreadInit(SDL_AudioDevice *device)
 {
     s32 current_priority = 0x30;
     svcGetThreadPriority(&current_priority, CUR_THREAD_HANDLE);
-    current_priority--;
-    // 0x18 is reserved for video, 0x30 is the default for main thread
-    current_priority = SDL_clamp(current_priority, 0x19, 0x2F);
+    if (svcGetProcessorID() == 1) {
+        // On the system core: run above the creator so audio never starves.
+        current_priority--;
+        // 0x18 is reserved for video, 0x30 is the default for main thread
+        current_priority = SDL_clamp(current_priority, 0x19, 0x2F);
+    } else {
+        /* Exult-3DS: on the application core (the system core was refused),
+           a higher priority lets audio mixing (FM synthesis) preempt the game
+           whenever it has work, which slowed everything ~100x. Run just below
+           the game instead; sound may stutter, but the game keeps its speed. */
+        current_priority = SDL_min(current_priority + 1, 0x3F);
+    }
     svcSetThreadPriority(CUR_THREAD_HANDLE, current_priority);
+    printf("[exult-3ds] audio thread on core %d, priority 0x%lx\n", svcGetProcessorID(), (long)current_priority);
 }
 
